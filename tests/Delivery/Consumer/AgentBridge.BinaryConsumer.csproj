<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <Import Project="$(AgentBridgeDeliveryRoot)/AgentBridge.Delivery.props" />
  <ItemGroup Condition="'$(AgentBridgeDeliveryProvider)' != 'SqlServer'">
    <Compile Remove="SqlServerRegistration.cs" />
  </ItemGroup>
</Project>
