<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**;**\bin\**;**\obj\**;**\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/legacy-api-baseline.json" LogicalName="AgentBridge.Tests.LegacyApiBaseline.json" />
    <Compile Include="../Delivery/Consumer/LegacyTransportSurfaceProbe.cs" Link="Consumer/LegacyTransportSurfaceProbe.cs" />
    <Compile Include="../Delivery/Consumer/Sub2ApiAuxiliaryUsage.cs" Link="Consumer/Sub2ApiAuxiliaryUsage.cs" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <ProjectReference Include="../../adapters/AgentBridge.Integration/AgentBridge.Integration.csproj" />
    <ProjectReference Include="../../adapters/AgentBridge.Persistence.SqlServer/AgentBridge.Persistence.SqlServer.csproj" />
  </ItemGroup>
</Project>
