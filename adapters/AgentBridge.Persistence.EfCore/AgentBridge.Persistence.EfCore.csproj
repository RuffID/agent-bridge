<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**;**\bin\**;**\obj\**;**\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../agent-bridge.csproj" />
    <ProjectReference Include="../../../work/EFCoreLibrary/EFCoreLibrary.csproj" />
    <ProjectReference Include="../../../work/EFCoreLibrary/maintenance/EFCoreLibrary.Maintenance.Sqlite/EFCoreLibrary.Maintenance.Sqlite.csproj" />
    <ProjectReference Include="../../../work/EFCoreLibrary/maintenance/EFCoreLibrary.Maintenance.PostgreSql/EFCoreLibrary.Maintenance.PostgreSql.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
</Project>
