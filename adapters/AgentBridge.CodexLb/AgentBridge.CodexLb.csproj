<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;artifacts\**;**\bin\**;**\obj\**;**\artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AgentBridge.Responses/*.cs" Link="Responses/Shared/%(Filename)%(Extension)" />
    <ProjectReference Include="../../AgentBridge/agent-bridge.csproj" />
    <ProjectReference Include="../../../work/HttpClientLibrary/HttpClientLibrary.csproj" />
  </ItemGroup>
</Project>
